# Where /api/lead forwards submissions (server-side only, never exposed to the client).
# Point this at a Google Apps Script web app that appends rows to a Google Sheet,
# or any Zapier/Make webhook that accepts a JSON POST.
LEAD_WEBHOOK_URL=

# Optional: where /api/crash-course forwards crash-course registrations.
# Leave empty to reuse LEAD_WEBHOOK_URL — the Apps Script in
# docs/google-apps-script.gs then files them in a separate "Crash Course
# Leads" tab. Set it to send them to a completely different spreadsheet.
CRASH_COURSE_WEBHOOK_URL=
